# =====================================================================
# Red Team Engine — Environment Variables
# =====================================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will NEVER be committed.
# All of these can also be entered directly in the Streamlit UI sidebar.
# =====================================================================

# --- Groq API (free at https://console.groq.com) ---------------------
GROQ_API_KEY=your_groq_api_key_here

# --- Optional: Pre-configure attack model ----------------------------
# ATTACK_PROVIDER=groq          # groq | openai | ollama | local
# ATTACK_API_KEY=               # leave blank to use GROQ_API_KEY
# ATTACK_BASE_URL=              # e.g. http://localhost:11434/v1 for Ollama
# ATTACK_MODEL_NAME=llama-3.3-70b-versatile

# --- Optional: Pre-configure target model ----------------------------
# TARGET_PROVIDER=groq
# TARGET_API_KEY=               # leave blank to use GROQ_API_KEY
# TARGET_BASE_URL=              # e.g. http://localhost:11434/v1 for Ollama
# TARGET_MODEL_NAME=llama-3.3-70b-versatile

# --- Engine tuning (optional) ----------------------------------------
# MAX_RETRIES=5
# MAX_WORKERS=4
# TIMEOUT_SECONDS=60
# OWASP_ENABLED=true
